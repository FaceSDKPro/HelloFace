    },
    "0–3000 ms，默认 0；匹配成功后等待，不控制帧率。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0–3000 ms, default 0. Wait after a match; does not control FPS."
