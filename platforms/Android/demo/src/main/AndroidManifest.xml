<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HiFaceDemoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HiFace.MainTheme">
        <activity
            android:name=".camera.CameraSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.HiFace.Content.Soft" />
        <activity
            android:name=".detection.FaceDetectionActivity"
            android:exported="false"
            android:theme="@style/Theme.HiFace.Camera"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".comparison.FaceComparisonActivity"
            android:theme="@style/Theme.HiFace.Content.Soft"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DemoHomeActivity"
            android:exported="true"
            android:theme="@style/Theme.HiFace"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".verification.FaceVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".liveness.FaceLivenessActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".verification.FaceEnrollmentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".search.FaceSearchActivity" android:exported="false" android:theme="@style/Theme.HiFace.Search" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".search.FaceSearchEnrollmentActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".search.FaceSearchLibraryActivity" android:exported="false" android:theme="@style/Theme.HiFace.Search" android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
