<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
    android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/backButton"
        style="@style/Widget.HiFace.Search.Icon" android:src="@drawable/ic_navigation_back"
        android:contentDescription="@string/cd_back" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
        android:text="@string/feature_uvc_camera_face_search" android:textSize="20sp"
        android:textStyle="bold" android:textColor="@android:color/white" />
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/uvcSettings"
        style="@style/Widget.HiFace.Search.Icon" android:src="@drawable/ic_search_settings"
        android:contentDescription="@string/uvc_search_settings_menu" />
</LinearLayout>
