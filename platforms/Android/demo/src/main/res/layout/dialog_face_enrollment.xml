<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="27dp"
    android:background="@drawable/bg_enroll_dialog"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp"
    tools:context=".verification.FaceEnrollmentActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/enroll_confirm_title"
        android:textColor="@color/api_background"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/capturedFaceImage"
        android:layout_width="188dp"
        android:layout_height="188dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_enroll_dialog_image"
        android:contentDescription="@string/cd_captured_face"
        android:scaleType="centerCrop" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/enroll_confirm_helper"
        android:textColor="@color/api_background"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/faceIdInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="@string/enroll_face_id_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:importantForAutofill="no"
        android:maxLength="64"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/retryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_enroll_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/enroll_retry"
            android:textColor="@color/api_background"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_enroll_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/enroll_confirm"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
