<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/uvc_enroll_camera_help" android:textSize="14sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/uvc_search_rgb_camera" />
    <Spinner android:id="@+id/uvcEnrollDevice" android:layout_width="match_parent" android:layout_height="48dp"
        android:saveEnabled="false" android:contentDescription="@string/uvc_search_rgb_camera" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/uvc_search_rgb_rotation" />
    <Spinner android:id="@+id/uvcEnrollRotation" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/uvc_search_rgb_rotation" />
    <com.google.android.material.button.MaterialButton android:id="@+id/uvcEnrollRefresh"
        android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:text="@string/uvc_search_refresh_devices" />
</LinearLayout>
