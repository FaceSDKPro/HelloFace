<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/content_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="60dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/backButton"
            style="@style/Widget.HiFace.NavigationButton.OnLight" android:contentDescription="@string/cd_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="@string/uvc_enroll_title"
            android:textColor="@color/content_text" android:textSize="20sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/uvcEnrollSettings"
            style="@style/Widget.HiFace.NavigationButton.OnLight" android:src="@drawable/ic_search_settings"
            android:contentDescription="@string/uvc_enroll_camera_settings" />
    </LinearLayout>
    <!-- 遮罩与预览使用相同的边界，圆框只露出实时画面。 -->
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" android:layout_marginTop="4dp" app:cardCornerRadius="24dp"
        app:cardElevation="0dp" app:cardBackgroundColor="@color/content_text"
        app:strokeColor="@color/surface_muted" app:strokeWidth="1dp">
        <TextureView android:id="@+id/uvcEnrollPreview" android:layout_width="match_parent" android:layout_height="match_parent"
            android:contentDescription="@string/uvc_search_rgb_camera" />
        <com.hiface.sdk.demo.ui.FaceCaptureOverlayView android:id="@+id/uvcEnrollOverlay"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:gravity="center_vertical" android:baselineAligned="false"
        android:background="@drawable/bg_camera_settings_card" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <androidx.appcompat.widget.AppCompatImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="10dp"
            android:src="@drawable/ic_search_person" app:tint="@color/content_accent"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/uvcEnrollStatus" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
            android:textSize="15sp" android:textColor="@color/content_text"
            android:text="@string/uvc_enroll_opening" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/uvcEnrollRetry"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="48dp" android:textAllCaps="false" android:text="@string/search_ui_retry_short"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
