<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/uvc_stream_preferences" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
        <Spinner android:id="@+id/uvcStreamResolution" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:saveEnabled="false" android:contentDescription="@string/uvc_stream_resolution" />
        <Spinner android:id="@+id/uvcStreamFps" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:saveEnabled="false" android:contentDescription="@string/uvc_stream_fps" />
    </LinearLayout>
</LinearLayout>
