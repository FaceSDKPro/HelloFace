<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_search_card" android:padding="14dp" android:layout_marginBottom="10dp">
    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="11dp" android:background="@drawable/bg_search_accent" android:src="@drawable/ic_search_person" app:tint="@color/search_accent" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_marginEnd="4dp">
        <TextView android:id="@+id/personId" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@android:color/white" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/personGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="11sp" android:textColor="@color/text_on_dark_secondary" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <ImageButton android:id="@+id/personDelete" style="@style/Widget.HiFace.Search.Icon" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_search_trash" app:tint="@color/text_on_dark_secondary" android:contentDescription="@string/search_delete"/>
</LinearLayout>
