<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/search_background">
    <include layout="@layout/view_uvc_search_header" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:paddingBottom="12dp">
        <include layout="@layout/view_uvc_search_preview" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="16dp" />
        <ScrollView android:layout_width="340dp" android:layout_height="match_parent" android:fillViewport="true">
            <include layout="@layout/view_uvc_search_controls" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
