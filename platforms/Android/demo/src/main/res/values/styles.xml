<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 所有页面左上角导航按钮共享相同尺寸、图标、点击区域和无障碍说明。 -->
    <style name="Widget.HiFace.NavigationButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:src">@drawable/ic_navigation_back</item>
    </style>

    <style name="Widget.HiFace.NavigationButton.OnDark" parent="Widget.HiFace.NavigationButton">
        <item name="android:background">@drawable/bg_api_action</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="Widget.HiFace.NavigationButton.OnLight" parent="Widget.HiFace.NavigationButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/api_background</item>
    </style>

    <style name="Widget.HiFace.CameraSwitchButton.OnLight"
        parent="Widget.HiFace.NavigationButton.OnLight">
        <item name="android:src">@drawable/ic_camera_switch</item>
    </style>

    <style name="ShapeAppearance.HiFace.Search.Dialog"
        parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.HiFace.Search.Icon" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_search_icon</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="Widget.HiFace.Search.CameraIcon" parent="Widget.HiFace.Search.Icon">
        <!-- 36dp visible circle, with a 48dp touch target. -->
        <item name="android:background">@drawable/bg_search_camera_control</item>
        <item name="android:padding">14dp</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="Widget.HiFace.Search.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/search_accent</item>
        <item name="android:textColor">@color/search_background</item>
        <item name="iconTint">@color/search_background</item>
        <item name="iconSize">20dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.HiFace.Search.Secondary" parent="Widget.HiFace.Search.Primary">
        <item name="backgroundTint">@color/search_surface</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@color/text_on_dark_secondary</item>
        <item name="strokeColor">@color/search_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.HiFace.Search.Field"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/search_field_stroke</item>
        <item name="hintTextColor">@color/search_accent</item>
        <item name="helperTextTextColor">@color/text_on_dark_secondary</item>
        <item name="android:textColorHint">@color/text_on_dark_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
